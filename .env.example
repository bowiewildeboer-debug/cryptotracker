# Copy to .env and fill in. Never commit .env - it is gitignored.

# Free CoinGecko Demo key: https://www.coingecko.com/en/developers/dashboard
# Without it, requests come from a shared IP pool and rate-limit hard
# (a universe build took 63s instead of 4s).
COINGECKO_API_KEY=

# Optional. Only needed to use the real CoinMarketCap ranking instead of CoinGecko's.
CMC_API_KEY=

# Web Push. Generate a pair once with:  npx web-push generate-vapid-keys
# The public key also goes into web/push-config.js, where it is safe to commit.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# The PushSubscription JSON the app shows after you enable notifications, one line each.
PUSH_SUBSCRIPTION_PHONE=
PUSH_SUBSCRIPTION_LAPTOP=
